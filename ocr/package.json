{
	"name": "ocr",
	"version": "0.0.1",
	"description": "Windows OCR插件，暂时只支持简体中文进行OCR",
	"scripts": {
		"clean": "rimraf dist",
		"build:vue": "vite build",
		"build:rust": "cd rust && cargo build --release",
		"build:copy": "node configs/copy-manifest.js",
		"build": "npm run clean && npm run build:vue && npm run build:rust && npm run build:copy"
	},
	"devDependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-shell": "~2",
		"@vitejs/plugin-vue": "^5.2.1",
		"esbuild": "^0.27.2",
		"rimraf": "^6.1.2",
		"vite": "^6.0.3",
		"vue": "^3.5.13"
	},
	"peerDependencies": {
		"naive-ui": "^2.41.0"
	}
}
