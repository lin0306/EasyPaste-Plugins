{
  "name": "ocr",
  "version": "0.0.3",
  "description": "基于 ocrs 的离线 OCR 插件，纯 Rust 实现，无需联网，开箱即用",
  "scripts": {
    "clean": "rimraf dist && rimraf ocr.zip",
    "build:vue": "vite build",
    "build:rust": "cd rust && cargo build --release",
    "build:copy": "node configs/copy-rust.js",
    "build": "pnpm run clean && pnpm run build:vue && pnpm run build:rust && pnpm run build:copy && pnpm run package",
    "dev": "vite",
    "package": "node configs/package-zip.js"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-shell": "~2",
    "@vitejs/plugin-vue": "^5.2.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.27.2",
    "rimraf": "^6.1.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3"
  },
  "peerDependencies": {
    "naive-ui": "^2.41.0"
  }
}
