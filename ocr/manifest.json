{  "id": "ocr",  "name": "OCR",  "version": "0.0.1",  "description": "Windows OCR插件，暂时只支持简体中文进行OCR",  "platform": "Windows",  "features":[    {      "id": "ocr-context",      "page": "list",      "type": "contextMenu",      "location": "image",      "menus": [        {          "menuId": "ocr-preview",          "label_ZH": "图片识别",          "label_EN": "OCR",          "click_fun": {            "type": "openWindow",            "width": 800,            "height": 600,            "params":[              "filePath"            ]          }        }      ]    },    {      "id": "ocr-preview",      "page": "plugins",      "type": "page",      "title_ZH": "图片识别",      "title_EN": "OCR"    }  ]}