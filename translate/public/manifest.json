{
  "id": "translate",
  "name": "文本翻译",
  "version": "0.0.4",
  "description": "多引擎翻译插件，支持 Microsoft、Google、DeepL、百度、有道等翻译服务",
  "platform": "Windows",
  "fileName": "translate.zip",
  "releaseUrl": "https://github.com/lin0306/EasyPaste-Plugins/releases/tag/translate-v0.0.4",
  "features": [
    {
      "id": "translate-context",
      "page": "list",
      "type": "contextMenu",
      "location": "text",
      "menus": [
        {
          "menuId": "translate-text",
          "labelCode": "contextMenu",
          "click_fun": {
            "type": "openWindow",
            "width": 700,
            "height": 500,
            "params": {
              "pageId": "view-page"
            }
          }
        }
      ]
    },
    {
      "id": "translate-page",
      "page": "plugins",
      "type": "page",
      "labelCode": "previewWindowTitle"
    },
    {
      "id": "translate-settings",
      "page": "plugins",
      "type": "settings"
    }
  ]
}
